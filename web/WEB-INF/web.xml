<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
  <display-name>jspShixun Web</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- 视频03：Servlet + DAO 获取数据库数据 -->
  <servlet>
    <servlet-name>UserServlet</servlet-name>
    <servlet-class>com.common.dbaccess.web.UserServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>UserServlet</servlet-name>
    <url-pattern>/user/*</url-pattern>
  </servlet-mapping>

  <!-- 视频07：城市管理 -->
  <servlet>
    <servlet-name>CityServlet</servlet-name>
    <servlet-class>com.common.dbaccess.web.CityServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CityServlet</servlet-name>
    <url-pattern>/city/*</url-pattern>
  </servlet-mapping>

  <!-- 视频08：天气数据 / 折线图 / 城市编号 -->
  <servlet>
    <servlet-name>WeatherServlet</servlet-name>
    <servlet-class>com.common.dbaccess.web.WeatherServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>WeatherServlet</servlet-name>
    <url-pattern>/weather/*</url-pattern>
  </servlet-mapping>
</web-app>
